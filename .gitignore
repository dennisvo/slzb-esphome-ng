# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml

# --- local-only working files (slzb-esphome-ng variant) ---
# Private appendices — do not publish
/docs/design-private.md
/docs/research/

# Mirrored SLZB-OS web UI (not for publication)
/web-os/


# Personal per-device configs (e.g. mr4u-local.yaml). Never committed.
/*-local.yaml

# Python bytecode from external components
__pycache__/
*.pyc
